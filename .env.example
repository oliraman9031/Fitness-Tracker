PORT=5000

DB_USER=your_postgres_username
DB_HOST=localhost
DB_NAME=sthira
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# Comma-separated frontend origins allowed to make credentialed API requests.
CLIENT_ORIGIN=http://localhost:5173
# Set to true when the app is served over HTTPS in production.
SESSION_COOKIE_SECURE=false

USDA_API_URL=https://api.nal.usda.gov/fdc/v1
USDA_API_KEY=your_usda_api_key

# Optional: server-side Google Gemini vision model for Diet > Scan Food.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest

# Optional AI configuration. Ollama is used by default.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional when AI_PROVIDER=openai:
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
